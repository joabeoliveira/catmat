# Configuração do banco de dados PostgreSQL
# Use a URL externa para o ambiente de produção e uma URL interna se necessário para comunicação interna.
DATABASE_URL=postgres://usuario:senha@host-externo:5432/nome-do-banco?sslmode=disable
DATABASE_URL_INTERNAL=postgres://usuario:senha@host-interno:5432/nome-do-banco?sslmode=disable

# Opcional: chave da API do Google Gemini para recursos de IA
GEMINI_API_KEY=

# Opcional: token de acesso para integrações externas
EXTERNAL_API_TOKEN=

# Opcional: chave da API CNPJ.biz para o terceiro fallback de consulta
CNPJBIZ_API_KEY=
# Opcional: URL base da API CNPJ.biz (padrão: https://cnpj.biz/api/v2/empresa)
CNPJBIZ_API_URL=https://cnpj.biz/api/v2/empresa

# Worker de sincronização diária de itens ARP para adesão
ARP_SYNC_HORA=2
ARP_SYNC_INTERVALO_MS=15000

# Opcional: URL base da aplicação em produção
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Opcional: configuração de ambiente
NODE_ENV=development

# MinIO / S3 compatível
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_ANP=anp

# Sincronização ANP
CRON_SECRET=
ANP_ADMIN_SECRET=

# Opcional
ANP_TIMEOUT_MS=60000
ANP_USER_AGENT=sistema-precos-anp/1.0


