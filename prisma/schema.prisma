// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tabela principal do CATMAT
model CatmatItem {
  codigoItem              Int                      @id @unique
  codigoGrupo             Int
  nomeGrupo               String
  codigoClasse            Int
  nomeClasse              String
  codigoPdm               Int
  nomePdm                 String
  descricaoItem           String                   @db.Text
  codigoNcm               String?
  aplicaMargemPreferencia Boolean                  @default(false)
  dataHoraAtualizacao     DateTime
  tsv                     Unsupported("tsvector")?

  // Relacionamentos
  compras CompraItem[]

  @@index([codigoGrupo])
  @@index([codigoClasse])
  @@index([codigoPdm])
  @@index([descricaoItem])
  @@index([nomePdm])
}

model CatserItem {
  codigoItem    Int                      @id @unique
  codigoGrupo   Int
  nomeGrupo     String
  codigoClasse  String
  nomeClasse    String
  codigoServico Int
  nomeServico   String
  statusServico Boolean                  @default(false)
  busca_tsv     Unsupported("tsvector")?

  @@index([codigoGrupo])
  @@index([codigoClasse])
  @@index([codigoServico])
  @@index([nomeServico])
}

// Medicamentos CATMAT — carga de referencia a partir de CSV
model MedicamentoCatmat {
  id                  Int      @id @default(autoincrement())
  codigoBr            String   @db.VarChar(20)
  catmat              String   @db.VarChar(30)
  principioAtivo      String
  concentracao        String
  formaFarmaceutica   String
  unidadeFornecimento String
  busca_tsv           Unsupported("tsvector")?
  importadoEm         DateTime @default(now())
  atualizadoEm        DateTime @default(now()) @updatedAt

  @@unique([codigoBr, catmat, principioAtivo, concentracao, formaFarmaceutica, unidadeFornecimento], map: "medicamentos_catmat_dados_uidx")
  @@index([catmat])
  @@index([principioAtivo])
}

// Salários por ocupação (CBO) e UF — base anual 2023..2026 com correção INPC
model SalarioCbo {
  id                      Int                      @id @default(autoincrement())
  uf                      String                   @db.Char(2)
  estado                  String
  cbo                     Int
  titulo                  String
  salario2023             Float?
  salario2024             Float?
  salario2025             Float?
  salario2026             Float?
  grandeGrupoCodigo       String?
  grandeGrupoTitulo       String?
  subgrupoPrincipalCodigo String?
  subgrupoPrincipalTitulo String?
  familiaCodigo           String?
  familiaTitulo           String?
  perfilOcupacional       String?                  @db.Text
  fonte                   String?
  atualizadoEm            DateTime                 @default(now()) @updatedAt
  busca_tsv               Unsupported("tsvector")?

  historico SalarioCboHistorico[]

  @@unique([uf, cbo])
  @@index([cbo])
  @@index([titulo])
  @@index([uf])
}

model SalarioCboOcupacao {
  cbo              Int      @id
  familiaCbo       Int
  titulo           String
  perfilOcupacional String?
  fonte            String?
  atualizadoEm     DateTime @default(now())

  @@index([familiaCbo])
  @@index([titulo])
  @@map("SalarioCboOcupacao")
}

model SalarioCboHistorico {
  id          Int        @id @default(autoincrement())
  cbo         Int
  uf          String     @db.Char(2)
  ano         Int
  salario     Float
  fonte       String?
  carregadoEm DateTime   @default(now())
  salarioCbo  SalarioCbo @relation(fields: [uf, cbo], references: [uf, cbo], onDelete: Cascade)

  @@unique([uf, cbo, ano])
  @@index([cbo, ano])
  @@index([uf, ano])
}

model SalarioCboPercentil {
  id          Int      @id @default(autoincrement())
  cbo         Int
  ano         Int
  observacoes Int
  p10         Float?
  p25         Float?
  p50         Float?
  p75         Float?
  p90         Float?
  media       Float?
  minimo      Float?
  maximo      Float?
  fonte       String?
  calculadoEm DateTime @default(now()) @updatedAt

  @@unique([cbo, ano])
  @@index([ano])
}

model SalarioCboSinonimo {
  id                  Int     @id @default(autoincrement())
  cbo                 Int
  ocupacaoCbo         Int?
  sinonimo            String
  sinonimoNormalizado String
  fonte               String?

  @@unique([cbo, sinonimoNormalizado])
  @@index([sinonimoNormalizado])
}

// Resumo de atividade de preços por item, preenchido pelo uso
// (toda consulta de preços grava aqui) — alimenta o selo "tem histórico"
// na busca sem precisar varrer a API do governo
model PrecoResumo {
  codigoItem        Int       @id
  quantidadeCompras Int
  periodoInicio     DateTime?
  periodoFim        DateTime?
  atualizadoEm      DateTime  @default(now()) @updatedAt
}

// Cache de compras da API do governo
model CompraItem {
  id                 String @id @default(cuid())
  idCompra           Int    @map("id_compra")
  idItemCompra       Int    @map("id_item_compra")
  numeroItemCompra   Int    @map("numero_item_compra")
  codigoItemCatalogo Int    @map("codigo_item_catalogo")

  // Dados da compra
  dataCompra         DateTime  @map("data_compra")
  dataResultado      DateTime? @map("data_resultado")
  modalidade         Int?
  forma              String?
  criterioJulgamento String?

  // Fornecedor
  niFornecedor   String? @map("ni_fornecedor")
  nomeFornecedor String? @map("nome_fornecedor")

  // Quantidades e preços
  quantidade              Float
  precoUnitario           Float  @map("preco_unitario")
  percentualMaiorDesconto Float? @map("percentual_maior_desconto")

  // Unidades
  siglaUnidadeFornecimento      String? @map("sigla_unidade_fornecimento")
  nomeUnidadeFornecimento       String? @map("nome_unidade_fornecimento")
  capacidadeUnidadeFornecimento Float?  @map("capacidade_unidade_fornecimento")
  siglaUnidadeMedida            String? @map("sigla_unidade_medida")

  // UASG
  codigoUasg  String? @map("codigo_uasg")
  nomeUasg    String? @map("nome_uasg")
  codigoOrgao Int?    @map("codigo_orgao")
  nomeOrgao   String? @map("nome_orgao")

  // Localização
  estado          String?
  codigoMunicipio Int?    @map("codigo_municipio")
  municipio       String?
  poder           String?
  esfera          String?

  // Datas de atualização
  dataAtualizacaoFato       DateTime  @map("data_atualizacao_fato")
  dataHoraAtualizacaoCompra DateTime? @map("data_hora_atualizacao_compra")
  dataHoraAtualizacaoItem   DateTime? @map("data_hora_atualizacao_item")
  dataHoraAtualizacaoUasg   DateTime? @map("data_hora_atualizacao_uasg")

  // Campos adicionais
  objetoCompra           String? @map("objeto_compra") @db.Text
  descricaoDetalhadaItem String? @map("descricao_detalhada_item") @db.Text
  marca                  String?
  idCompraItem           String? @map("id_compra_item")

  // Relacionamentos
  catmatItem CatmatItem @relation(fields: [codigoItemCatalogo], references: [codigoItem])

  @@unique([idCompra, idItemCompra])
  @@index([codigoItemCatalogo])
  @@index([dataCompra])
  @@index([codigoUasg])
  @@index([dataAtualizacaoFato])
  @@map("compras_item")
}

// Atas de Registro de Preços do módulo ARP do Compras.gov.br
model ArpAta {
  id                       String    @id @default(cuid())
  numeroControlePncpAta    String    @unique @map("numero_controle_pncp_ata")
  numeroControlePncpCompra String?   @map("numero_controle_pncp_compra")
  numeroAtaRegistroPreco   String    @map("numero_ata_registro_preco")
  codigoUnidadeGerenciadora String   @map("codigo_unidade_gerenciadora")
  nomeUnidadeGerenciadora  String?
  codigoOrgao              Int?      @map("codigo_orgao")
  nomeOrgao                String?
  linkAtaPncp              String?   @map("link_ata_pncp")
  linkCompraPncp           String?   @map("link_compra_pncp")
  numeroCompra             String?   @map("numero_compra")
  anoCompra                String?   @map("ano_compra")
  codigoModalidadeCompra   String?   @map("codigo_modalidade_compra")
  nomeModalidadeCompra     String?   @map("nome_modalidade_compra")
  dataAssinatura           DateTime? @map("data_assinatura") @db.Date
  dataVigenciaInicial      DateTime? @map("data_vigencia_inicial") @db.Date
  dataVigenciaFinal        DateTime? @map("data_vigencia_final") @db.Date
  valorTotal               Float?    @map("valor_total")
  statusAta                String?   @map("status_ata")
  objeto                   String?   @db.Text
  quantidadeItens          Int?      @map("quantidade_itens")
  dataHoraAtualizacao      DateTime? @map("data_hora_atualizacao")
  dataHoraInclusao         DateTime? @map("data_hora_inclusao")
  dataHoraExclusao         DateTime? @map("data_hora_exclusao")
  ataExcluido              Boolean   @default(false) @map("ata_excluido")
  sincronizadoEm           DateTime  @default(now()) @map("sincronizado_em")

  itens ArpItem[]

  @@index([codigoUnidadeGerenciadora])
  @@index([dataVigenciaFinal])
  @@index([dataVigenciaInicial])
  @@index([ataExcluido])
  @@index([numeroAtaRegistroPreco])
  @@map("arp_atas")
}

// Itens da ata, carregados pelo endpoint 2_consultarARPItem
model ArpItem {
  id                         String   @id @default(cuid())
  ataId                      String   @map("ata_id")
  numeroControlePncpAta      String   @map("numero_controle_pncp_ata")
  numeroItem                 String   @map("numero_item")
  codigoItem                 Int?     @map("codigo_item")
  descricaoItem              String?  @map("descricao_item") @db.Text
  descricaoDetalhada         String?  @map("descricao_detalhada") @db.Text
  tipoItem                   String?  @map("tipo_item")
  numeroCompra               String?  @map("numero_compra")
  anoCompra                  String?  @map("ano_compra")
  dataAssinatura             DateTime? @map("data_assinatura") @db.Date
  dataVigenciaInicial        DateTime? @map("data_vigencia_inicial") @db.Date
  dataVigenciaFinal          DateTime? @map("data_vigencia_final") @db.Date
  niFornecedor               String?  @map("ni_fornecedor")
  nomeRazaoSocialFornecedor  String?  @map("nome_razao_social_fornecedor")
  quantidadeHomologadaVencedor Float? @map("quantidade_homologada_vencedor")
  quantidadeHomologadaItem   Float?   @map("quantidade_homologada_item")
  quantidadeRegistrada       Float?   @map("quantidade_registrada")
  unidadeMedida              String?  @map("unidade_medida")
  valorUnitario              Float?   @map("valor_unitario")
  valorTotal                 Float?   @map("valor_total")
  maximoAdesao               Float?   @map("maximo_adesao")
  numeroControlePncpCompra   String?  @map("numero_controle_pncp_compra")
  idCompra                   String?  @map("id_compra")
  atualizadoEm               DateTime @default(now()) @updatedAt @map("atualizado_em")

  ata ArpAta @relation(fields: [ataId], references: [id], onDelete: Cascade)

  @@unique([numeroControlePncpAta, numeroItem])
  @@index([codigoItem])
  @@index([dataVigenciaFinal])
  @@index([descricaoItem])
  @@index([ataId])
  @@map("arp_itens")
}

// Licitações municipais homologadas no TCE-PR (carga XML — preços de referência)
model ArpItemAdesao {
  id String @id @default(cuid())
  numeroControlePncpAta String @map("numero_controle_pncp_ata")
  numeroAtaRegistroPreco String? @map("numero_ata_registro_preco")
  codigoUnidadeGerenciadora String? @map("codigo_unidade_gerenciadora")
  nomeUnidadeGerenciadora String? @map("nome_unidade_gerenciadora")
  numeroControlePncpCompra String? @map("numero_controle_pncp_compra")
  numeroCompra String? @map("numero_compra")
  anoCompra String? @map("ano_compra")
  codigoModalidadeCompra String? @map("codigo_modalidade_compra")
  nomeModalidadeCompra String? @map("nome_modalidade_compra")
  dataAssinatura DateTime? @map("data_assinatura") @db.Date
  dataVigenciaInicial DateTime? @map("data_vigencia_inicial") @db.Date
  dataVigenciaFinal DateTime? @map("data_vigencia_final") @db.Date
  numeroItem String @map("numero_item")
  codigoItem Int? @map("codigo_item")
  descricaoItem String? @map("descricao_item") @db.Text
  tipoItem String? @map("tipo_item")
  classificacaoFornecedor String? @map("classificacao_fornecedor")
  niFornecedor String? @map("ni_fornecedor")
  nomeRazaoSocialFornecedor String? @map("nome_razao_social_fornecedor")
  quantidadeHomologadaItem Float? @map("quantidade_homologada_item")
  quantidadeHomologadaVencedor Float? @map("quantidade_homologada_vencedor")
  quantidadeEmpenhada Float? @map("quantidade_empenhada")
  valorUnitario Float? @map("valor_unitario")
  valorTotal Float? @map("valor_total")
  maximoAdesao Float @map("maximo_adesao")
  itemExcluido Boolean @default(false) @map("item_excluido")
  dataHoraInclusao DateTime? @map("data_hora_inclusao")
  dataHoraAtualizacao DateTime? @map("data_hora_atualizacao")
  sincronizadoEm DateTime @default(now()) @map("sincronizado_em")

  @@unique([numeroControlePncpAta, numeroItem])
  @@index([codigoItem])
  @@index([codigoUnidadeGerenciadora])
  @@index([dataVigenciaFinal])
  @@index([maximoAdesao])
  @@index([descricaoItem])
  @@map("arp_itens_adesao")
}

model LicitacaoVencedorTcePr {
  id                     Int       @id @default(autoincrement())

  // Dados da entidade e município
  cdIbge                 String?
  nmMunicipio            String
  idPessoa               Int?
  nmEntidade             String

  // Dados do processo licitatório
  idLicitacao            Int
  nrAnoLicitacao         Int
  nrLicitacao            Int
  dsModalidadeLicitacao  String
  dtHomologacao          DateTime?

  // Fornecedor / proponente
  nrDocumento            String
  nmPessoa               String

  // Dados do item e proposta
  nrLote                 Int       @default(1)
  nrItem                 Int
  dsItem                 String    @db.Text
  idUnidadeMedida        Int?
  dsUnidadeMedida        String?
  nrQuantidade           Float?

  // Valores de referência (mínimo / máximo do item)
  vlMinimoUnitarioItem   Float?
  vlMinimoTotal          Float?
  vlMaximoUnitarioItem   Float?
  vlMaximoTotal          Float?

  // Valores da proposta e do vencedor
  nrQuantidadeProposta   Float?
  vlPropostaItem         Float?
  nrQuantidadeVencedor   Float?
  vlLicitacaoVencedor    Float?
  nrClassificacao        Int

  // Condições comerciais e prazos
  dsFormaPagamento       String?
  nrPrazoLimiteEntrega   Int?
  idTipoEntregaProduto   Int?
  dsTipoEntregaProduto   String?
  dtValidadeProposta     DateTime?
  dtPrazoEntregaProposta DateTime?

  // Controle SIMAM / TCE-PR
  ultimoEnvioSimam       String?
  dataReferencia         String?
  importadoEm            DateTime  @default(now())

  busca_tsv              Unsupported("tsvector")?

  @@unique([idLicitacao, nrLote, nrItem, nrDocumento, nrClassificacao])
  @@index([cdIbge, nrAnoLicitacao])
  @@index([nrDocumento])
  @@index([dtHomologacao])
  @@index([idLicitacao])
  @@index([dsModalidadeLicitacao])
}

// Atividades do perfil ocupacional (CBO 2002 — arquivo cbo_perfilocupacional.csv)
// cbo = ocupação (6 dígitos, ex.: 20105) → liga SalarioCboOcupacao.cbo
// familiaCbo = família (4 dígitos, ex.: 201) → liga SalarioCbo.cbo
model SalarioCboAtividade {
  id                      Int      @id @default(autoincrement())
  cbo                     Int
  familiaCbo              Int
  codigoAtividade         Int
  nomeAtividade           String
  siglaGrandeArea         String
  grandeArea              String
  grandeGrupoCodigo       Int
  subgrupoPrincipalCodigo Int
  subgrupoCodigo          Int
  familiaCodigo           Int
  fonte                   String?
  atualizadoEm            DateTime @default(now()) @updatedAt

  @@unique([cbo, siglaGrandeArea, codigoAtividade])
  @@index([cbo])
  @@index([familiaCbo])
  @@index([grandeArea])
  @@map("SalarioCboAtividade")
}
